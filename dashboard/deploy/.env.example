# ==============================================================================
# Hydraulic System - Production Environment Configuration Template
# Copy this file to .env in your production environment:
#   cp .env.example .env
# ==============================================================================

# Server Network Configuration
PORT=9999
NODE_ENV=production

# Trust Proxy (Must be 1 when running behind Nginx, Caddy, or Cloudflare)
# Enables proper client IP detection for rate-limiting, audit logs, and secure cookies.
TRUST_PROXY=1

# Production Authentication Secret
# CRITICAL: Generate a strong random 64-character secret using:
#   openssl rand -hex 32
# If not provided, a secret will be generated and saved to .auth-secret on first run.
BILLING_SECRET=replace_with_openssl_generated_64_character_hex_secret

# Authentication Master Switch (Never set to 'off' in production!)
BILLING_AUTH=on

# Fallback Bootstrap Admin Password (only used before initial admin is created)
# Once users exist in the Users table, this fallback is disabled.
# BILLING_PASSWORD=YourStrongBootstrapPassword2026!
